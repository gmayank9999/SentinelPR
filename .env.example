# Copy to .env or export these before `python -m sentinel.api`. Never commit real values.
# The server reads them from its environment only; they are never sent to the browser.

# --- GitHub (read pull requests; private repositories need a token with access) ---
# Minimum: fine-grained token with Metadata, Contents and Pull requests = read.
# Add Pull requests = write only if you want runs to post a PR comment.
# Commit status (Commit statuses: Read and write) works with this token and can be a required check in branch protection.
# A Check Run cannot be created with ANY personal token; GitHub requires a GitHub App (see below and docs/github-app.md).
GITHUB_TOKEN=

# --- GitHub App (only for Check Runs; optional, see docs/github-app.md) ---
SENTINEL_GITHUB_APP_CLIENT_ID=
SENTINEL_GITHUB_APP_PRIVATE_KEY_PATH=   # path to the downloaded .pem, kept OUTSIDE this repository; never paste the key here
# SENTINEL_GITHUB_APP_INSTALLATION_ID=  # optional: skips looking the installation up

# --- Language models (optional; without one SentinelPR runs in evidence-only mode) ---
GROQ_API_KEY=            # several keys may be comma-separated; each is used when the previous hits its quota
GEMINI_API_KEY=
# Ollama needs no key: run it locally and `ollama pull qwen2.5-coder:1.5b`

# --- Server access ---
SENTINEL_API_TOKEN=      # when set, every API request needs "Authorization: Bearer <token>"
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Side effects: all off by default ---
SENTINEL_ALLOW_PUBLISH=0         # 1 lets a run (that asks for it) post its Check Run / PR comment
SENTINEL_ALLOW_PUBLISH_FORKS=    # set to allow publishing on pull requests from forks

# --- Tuning (see sentinel/config.yaml) ---
SENTINEL__SERVICE__MAX_CONCURRENT_RUNS=2
SENTINEL__SANDBOX__MEMORY=1g
SENTINEL__SANDBOX__CPUS=1.5
SENTINEL__SANDBOX__PIDS=256
